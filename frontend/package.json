{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/react": "^18.2.0",
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.15"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.38",
    "glob": "^9.3.5",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:bootstrap": "REACT_APP_THEME=bootstrap react-scripts start",
    "build": "npm run build:tailwind && react-scripts build",
    "build:tailwind": "npx tailwindcss -i ./src/index.css -o ./src/styles/tailwind.css",
    "build:bootstrap": "REACT_APP_THEME=bootstrap react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1"
  },
  "main": "src/index.js"
}
