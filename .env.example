# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Configuration (PostgreSQL) – backend and migrations use this. All data in Supabase = use Option B.
#
# Option A – Local Docker Postgres (run: docker-compose --profile local-db up -d db first):
#   SUPABASE_DB_HOST=db
#   SUPABASE_DB_PORT=5432
#   SUPABASE_DB_NAME=postgres
#   SUPABASE_DB_USER=postgres
#   SUPABASE_DB_PASSWORD=any-local-password
#
# Option B – Supabase only (recommended; no local db container):
#   Dashboard → Your Project → Settings → Database → Connect. Use Direct or Connection pooling.
#   Direct: Host = db.<project-ref>.supabase.co, Port = 5432, User = postgres.<project-ref>
#   Pooler (Session): Host = aws-0-<region>.pooler.supabase.com, Port = 5432, User = postgres.<project-ref>
#   Set SUPABASE_DB_SSLMODE=require. Password = your DB password from the same Connect dialog.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_SSLMODE=require

# Frontend (build-time only; used when running npm run build for deployment)
# REACT_APP_API_URL=https://your-backend.example.com/api
# Tenant-specific deployment: set to a slug (e.g. demo-bhis) to lock Help, Events, and API to that tenant. Unset = default demo-circle.
# REACT_APP_TENANT_SLUG=demo-bhis

# Optional: restrict registration to specific email domains (avoids duplicates / keeps users app-specific).
# Comma-separated, e.g. ALLOWED_EMAIL_DOMAINS=campuscircle.com or school.edu,campuscircle.com
# Leave unset to allow any domain.
# ALLOWED_EMAIL_DOMAINS=campuscircle.com
