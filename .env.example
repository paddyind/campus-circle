# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Configuration (PostgreSQL)
# Used by: infra/scripts/db.py (migrate, reset, backup), Docker migrations service, backend when using direct DB.
#
# Option A – Local Docker only (backend + migrations talk to the "db" container):
#   SUPABASE_DB_HOST=db
#   SUPABASE_DB_PORT=5432
#   SUPABASE_DB_NAME=postgres
#   SUPABASE_DB_USER=postgres
#   SUPABASE_DB_PASSWORD=any-local-password
#
# Option B – Supabase Cloud (same project as SUPABASE_URL; schemas campus_circle + campus_circle_auth):
#   Dashboard → Your Project → Settings → Database → Connect (copy URI or parameters).
#   Direct (IPv6, port 5432): Host = db.<project-ref>.supabase.co, Port = 5432.
#   If you get "Network is unreachable" when deployed (e.g. no IPv6): use the pooler from the same
#   Connect dialog → "Connection pooling" → Session mode (IPv4) or Transaction mode:
#     - Session mode: Host = aws-0-<region>.pooler.supabase.com, Port = 5432, User = postgres.<project-ref>
#     - Transaction mode: Host = db.<project-ref>.supabase.co, Port = 6543, User = postgres
#   Set SUPABASE_DB_SSLMODE=require for any Supabase connection.
SUPABASE_DB_HOST=db
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-secure-password-here
# Required for Supabase (direct or pooler). Omit for local Postgres.
SUPABASE_DB_SSLMODE=require

# Optional: restrict registration to specific email domains (avoids duplicates / keeps users app-specific).
# Comma-separated, e.g. ALLOWED_EMAIL_DOMAINS=campuscircle.com or school.edu,campuscircle.com
# Leave unset to allow any domain.
# ALLOWED_EMAIL_DOMAINS=campuscircle.com
