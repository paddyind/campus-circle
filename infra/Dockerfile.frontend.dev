# Development Dockerfile for Frontend
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm install

# Copy frontend source
COPY frontend/ ./

# Expose development server port
EXPOSE 3000

# Generate Tailwind CSS before starting
CMD ["sh", "-c", "npm run build:tailwind && npm start"]

