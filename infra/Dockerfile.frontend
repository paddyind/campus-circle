# Development target: run frontend dev server (docker-compose --profile dev)
FROM node:20-alpine AS dev
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install
COPY frontend/ ./
EXPOSE 3000
CMD ["sh", "-c", "npm ci && npm run build:tailwind && npm start"]

# Production: build then serve with Nginx
# Build with: docker build -f infra/Dockerfile.frontend --build-arg REACT_APP_API_URL=https://your-api.example.com/api -t campus-circle-frontend .
FROM node:20-alpine AS build
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM nginx:stable-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
